# Server-only Gemini key (local .env and hosting environment variables).
# Never prefix this with VITE_ — it must stay on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Firebase client (browser) ---------------------------------------------
# Anonymous Auth only. These values identify the Firebase project; they are
# not secrets, but keep them in Vercel environment variables anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase Admin (server only) ------------------------------------------
# Use either the three separate values or a single service-account JSON blob.
# Never prefix these with VITE_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional alternative to the three values above. Paste the full JSON on one
# line, or use GOOGLE_APPLICATION_CREDENTIALS locally.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Local development alternative: path to a service-account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# --- Firebase emulators (local development) --------------------------------
# Set these to use the Auth + Firestore emulators instead of a real project.
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
